# Copia este archivo a .env (que no se sube al repositorio) si quieres
# cambiar algo. Todo es opcional.

# Puerto de la API.
# PORT=8080

# Carpeta de la base local (domfin.db). Por defecto, la carpeta de
# configuración de tu usuario: ~/Library/Application Support/domfin-api en
# macOS, ~/.config/domfin-api en Linux, %AppData%\domfin-api en Windows.
# DOMFIN_DATA_DIR=

# Contraseña de respaldo para los PDF de estados de cuenta. Lo normal es
# guardarla en Configuración, en la app, que tiene prioridad. Si tiene
# espacios, # o comillas, escríbela entre comillas simples: '...'
# STATEMENTS_PDF_PASSWORD=

# off para que la API nunca le pregunte a GitHub si hay una versión nueva.
# DOMFIN_UPDATE_CHECK=off
