{
  "expo": {
    "name": "Domfin",
    "slug": "domfin",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.powky.domfin"
    },
    "android": {
      "package": "com.powky.domfin",
      "adaptiveIcon": {
        "backgroundColor": "#E8622C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121110"
          }
        }
      ],
      "./plugins/with-statement-sharing"
    ],
    "scheme": "domfin",
    "experiments": {
      "typedRoutes": true
    }
  }
}
